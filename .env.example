APP_ENV=development
SECRET_KEY=dev-only-change-this-secret-to-a-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://unik:replace-with-a-long-random-password@db:5432/unik
BOOTSTRAP_TOKEN=replace-with-a-random-secret-at-least-32-characters
METRICS_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
DOCUMENT_STORAGE_PATH=/var/lib/unik/uploads
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=45
ANTIVIRUS_SIGNATURE_MAX_AGE_HOURS=72
ANTIVIRUS_INFECTED_RETENTION_DAYS=30
ANTIVIRUS_CLEANUP_INTERVAL_HOURS=24
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_QUEUE_MAX_AGE_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
APP_BASE_URL=http://127.0.0.1:3000
NOTIFICATION_TIMEZONE=America/Santarem
